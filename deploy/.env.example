# Порт, на котором будет доступен веб-интерфейс: http://<сервер>:APP_PORT/ui/schedules
# Если занят — поменяйте на любой свободный.
APP_PORT=18080

# Пароль базы данных. Обязательно замените перед первым запуском.
# Только латинские буквы и цифры: пароль подставляется в строку подключения,
# символы @ : / ? в нём её ломают.
DB_PASSWORD=change-me

# Версия образа приложения (тег, с которым он был собран).
APP_VERSION=latest
